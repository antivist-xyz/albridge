
# ==================================================
# ALBRIDGE — EXAMPLE CONFIGURATION
# ==================================================
# Copy this file to .env and configure credentials.
# Never commit your real .env file.

# --------------------------------------------------
# ANTIVIST TESTNET
# --------------------------------------------------

ANTIVIST_BASE_URL=https://testnet.antivist.xyz

# Generate API credentials from your Antivist account.
ANTIVIST_API_KEY=
ANTIVIST_API_SECRET=

# --------------------------------------------------
# MARKET SELECTION
# --------------------------------------------------

# Antivist team market slug.
# Can be overridden with --market.
# Example: manchester-city
ANTIVIST_MARKET_SLUG=manchester-city

# --------------------------------------------------
# EXECUTION
# --------------------------------------------------

# 0 = DRY RUN: no live order reconciliation
# 1 = LIVE: submit and cancel orders on Antivist
#
# LIVE mode is intended for controlled testnet use.
ALBRIDGE_EXECUTE_LIVE=0

# Optional single-order testnet submission.
# Keep disabled for normal operation.
ALBRIDGE_TESTNET_SMOKE=0

# --------------------------------------------------
# QUOTING & RISK LIMITS
# --------------------------------------------------

# Maximum aggregate desired quote notional.
ALBRIDGE_MAX_TOTAL_NOTIONAL=20000

# Maximum notional for one desired order.
ALBRIDGE_MAX_ORDER_NOTIONAL=2500

# Number of price levels per side.
ALBRIDGE_LEVELS_PER_SIDE=5

# Quantity decay between subsequent levels.
# Must be greater than 0 and at most 1.
ALBRIDGE_LEVEL_SIZE_DECAY=0.80

# --------------------------------------------------
# LOGGING
# --------------------------------------------------

ALBRIDGE_LOG_DIR=logs

# --------------------------------------------------
# TERMINAL DISPLAY
# --------------------------------------------------

# 1 = relaxed visual freshness thresholds for demos.
# Does not modify trading risk controls.
ALBRIDGE_VIDEO_MODE=0
